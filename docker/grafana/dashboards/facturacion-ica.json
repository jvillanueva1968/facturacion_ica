{
  "uid": "facturacion-ica",
  "title": "Facturación ICA · Métricas",
  "tags": ["facturacion", "ica"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Comprobantes (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(comprobantes_procesados_total)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exitosos",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(comprobantes_procesados_total{status=\"completed\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fallidos",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(comprobantes_procesados_total{status=\"failed\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests HTTP 5xx (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 3 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Confianza OCR (proximidad)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(comprobantes_procesados_total{status=\"completed\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "description": "Conteo acumulado de comprobados completados (la confianza OCR promedio vive en el dashboard de la app)"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Procesos en curso",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(comprobantes_procesados_total) - sum(comprobantes_procesados_total{status=~\"completed|failed\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Procesamiento por estado (tasa)",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(comprobantes_procesados_total[5m]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Duración de procesamiento p95 / p50",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(comprobante_procesamiento_segundos_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(comprobante_procesamiento_segundos_bucket[5m])))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Llamadas LLM y SNRI",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "sum by (resultado) (rate(llm_llamadas_total[5m]))", "legendFormat": "llm {{resultado}}" },
        { "refId": "B", "expr": "sum by (resultado) (rate(snri_llamadas_total[5m]))", "legendFormat": "snri {{resultado}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Extracciones por perfil",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "sum by (perfil) (extracciones_total)", "legendFormat": "{{perfil}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests HTTP por estado",
      "datasource": { "type": "prometheus", "uid": "prometheus-ica" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_requests_total[5m]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ]
}
