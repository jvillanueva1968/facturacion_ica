ENVIRONMENT=development
APP_SECRET_KEY=generate-with-openssl-rand-base64-32

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/facturacion
REDIS_URL=redis://redis:6379/0

SNRI_WSDL_URL=http://webservices.ica.gov.co/WS_FACTURACION/?WSDL
SNRI_WSDL_LOCAL_PATH=./wsdl/WS_FACTURACION.wsdl
SNRI_CERT_PATH=./certs/cliente.p12
SNRI_CERT_PASSWORD=your_cert_password_here
SNRI_TIMEOUT=30
SNRI_ID_PROYECTO=0
SNRI_USERNAME=
SNRI_PASSWORD=
SNRI_IP=
SNRI_PROCESO=

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OPENROUTER_API_KEY=

SIGMA_API_URL=http://sigma-mock/api
SIGMA_API_TOKEN=your_sigma_api_token_here
SNRI_DEMO_MODE=false

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_PER_MINUTE=60
ACCESS_TOKEN_EXPIRE_MINUTES=30